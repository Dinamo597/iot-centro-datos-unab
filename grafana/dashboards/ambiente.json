{
  "uid": "lab5-ambiente",
  "title": "Sala de servidores UNAB - Ambiente",
  "description": "El operador vigila que la temperatura se mantenga bajo 30 °C, la humedad entre 30 y 70 % y que la iluminancia sea coherente con la hora del día.",
  "tags": [
    "lab5",
    "iot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-4d",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "Qué mira el operador",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Temperatura bajo **30 °C**, humedad entre **30 y 70 %**, iluminancia acorde a la hora del día. Ventana: últimos 4 días."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Temperatura actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 10,
          "max": 40,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 28
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"temperature\")\n  |> last()"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Humedad actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "humidity",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 30
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ambiente\" and r._field == \"humidity\")\n  |> last()"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Iluminancia actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
