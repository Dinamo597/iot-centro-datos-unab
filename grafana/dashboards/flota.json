{
  "uid": "parcial2-dc",
  "title": "Centro de datos UNAB - Flota IoT",
  "description": "Parcial 2 IoT a la Medida: 10 dispositivos, ventana configurable y reglas de alerta.",
  "tags": [
    "parcial2",
    "iot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Qué mira el operador",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Centro de datos UNAB: 10 dispositivos (Digital Twin, API, DataSet y Real). El operador vigila temperatura de racks < 30 °C, potencia, UPS (batería y voltaje), puerta y salud de la VM. Use el selector de tiempo para ajustar la ventana; la leyenda de cada gráfica muestra promedio, máximo, mínimo y último valor del rango elegido."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dispositivos reportando (15 min)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 6
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"iot\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"dc\")\n  |> keep(columns: [\"device\"])\n  |> group()\n  |> distinct(column: \"device\")\n  |> count()"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Estado reportado por dispositivo (enabled / interval s)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 18,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"iot\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"dc_state\" and (r._field == \"enabled\" or r._field == \"interval\"))\n  |> last()\n  |> keep(columns: [\"device\", \"origin\", \"_field\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"device\", \"origin\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temperatura racks y pasillo (°C)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "min",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "spanNulls": false
          },
          "displayName": "${__field.labels.device}"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"dc\" and r._field == \"temperature\" and r.device =~ /^(rack-a|rack-b|rack-c|pasillo)$/)\n  |> group(columns: [\"device\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
